{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "C++ Launch (External Console)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\build\\ChessEngine.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\build",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "D:\\Apps\\MSYS2\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}